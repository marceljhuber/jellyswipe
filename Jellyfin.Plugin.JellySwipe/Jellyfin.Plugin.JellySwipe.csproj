<Project Sdk="Microsoft.NET.Sdk">

  <!--
    One source tree, one build per Jellyfin line (the plugin ABI changes between them):
      dotnet build -p:JellyfinTarget=10.9   → net8.0,  Jellyfin 10.9.x
      dotnet build -p:JellyfinTarget=10.10  → net8.0,  Jellyfin 10.10.x
      dotnet build -p:JellyfinTarget=10.11  → net9.0,  Jellyfin 10.11.x (default)
      dotnet build -p:JellyfinTarget=12     → net10.0, Jellyfin 12.x
    The 4th version component encodes the target so Jellyfin's catalog picks the right build.
  -->
  <PropertyGroup>
    <PluginVersion>0.3.0</PluginVersion>
  </PropertyGroup>

  <PropertyGroup Condition="'$(JellyfinTarget)' == '10.9'">
    <TargetFramework>net8.0</TargetFramework>
    <JellyfinPackageVersion>10.9.0</JellyfinPackageVersion>
    <TargetAbi>10.9.0.0</TargetAbi>
    <AbiCode>109</AbiCode>
    <DefineConstants>$(DefineConstants);JF_10_9</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinTarget)' == '10.10'">
    <TargetFramework>net8.0</TargetFramework>
    <JellyfinPackageVersion>10.10.0</JellyfinPackageVersion>
    <TargetAbi>10.10.0.0</TargetAbi>
    <AbiCode>1010</AbiCode>
    <DefineConstants>$(DefineConstants);JF_10_10</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinTarget)' == '10.11'">
    <TargetFramework>net9.0</TargetFramework>
    <JellyfinPackageVersion>10.11.0</JellyfinPackageVersion>
    <TargetAbi>10.11.0.0</TargetAbi>
    <AbiCode>1011</AbiCode>
    <DefineConstants>$(DefineConstants);JF_10_11;JF_GE_10_11</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(JellyfinTarget)' == '12'">
    <TargetFramework>net10.0</TargetFramework>
    <JellyfinPackageVersion>12.0.0</JellyfinPackageVersion>
    <TargetAbi>12.0.0.0</TargetAbi>
    <AbiCode>1200</AbiCode>
    <DefineConstants>$(DefineConstants);JF_12;JF_GE_10_11</DefineConstants>
  </PropertyGroup>

  <PropertyGroup>
    <RootNamespace>Jellyfin.Plugin.JellySwipe</RootNamespace>
    <AssemblyVersion>$(PluginVersion).$(AbiCode)</AssemblyVersion>
    <FileVersion>$(PluginVersion).$(AbiCode)</FileVersion>
    <Version>$(PluginVersion)</Version>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="Jellyfin.Controller" Version="$(JellyfinPackageVersion)" ExcludeAssets="runtime" />
    <PackageReference Include="Jellyfin.Model" Version="$(JellyfinPackageVersion)" ExcludeAssets="runtime" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Web\**\*" LogicalName="Web/%(RecursiveDir)%(Filename)%(Extension)" />
    <EmbeddedResource Include="Configuration\configPage.html" />
  </ItemGroup>

</Project>
