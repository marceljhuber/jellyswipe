# Copy to .env (gitignored). Everything is optional: without it, the web UI
# asks for the Jellyfin URL + login on first start and stores a token in data/auth.json.

# Jellyfin address as seen from the JellySwipe server
JELLYFIN_URL=http://jellyfin.local:8096

# Address browsers should use for "Open in Jellyfin" links (defaults to JELLYFIN_URL)
# JELLYFIN_PUBLIC_URL=https://jellyfin.example.com

# Option A: API key (Dashboard → API Keys). JELLYFIN_USERNAME picks whose libraries/watch state to use.
# JELLYFIN_API_KEY=
# JELLYFIN_USERNAME=

# Option B: log in on start with a user account
# JELLYFIN_USERNAME=
# JELLYFIN_PASSWORD=

# PORT=8097
# AUTOPLAY_DELAY_MS=10000
